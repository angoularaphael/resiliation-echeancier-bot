# === BotHosting prem-eu2 : copier en /home/container/.env (NE PAS committer) ===
# Vercel : BOXPLUS_BOT_URL_OPS=http://prem-eu2.bot-hosting.net:21268

BOT_REPO_URL=https://github.com/angoularaphael/resiliation-echeancier-bot.git
BOT_REPO_BRANCH=main
BOT_APP_DIR=echeancier-resiliation-bot-app

BOT_ROLE=ops

# Deciplus (compte résils / changements)
DECIPLUS_URL=https://boxingcenter.deciplus.pro/
DECIPLUS_USER=EDDY
DECIPLUS_PASSWORD=
DECIPLUS_DEFAULT_SITE=Minimes
DECIPLUS_HEADLESS=true
DECIPLUS_NAV_TIMEOUT=90000
DECIPLUS_NAV_SETTLE_MS=1500

# Code 2FA Deciplus — IMAP (mot de passe d'APPLICATION Google)
DECIPLUS_IMAP_USER=konizakoniza3@gmail.com
DECIPLUS_IMAP_PASS=
DECIPLUS_IMAP_HOST=imap.gmail.com
DECIPLUS_IMAP_PORT=993

BOT_DATA_DIR=data
BOT_SESSION_DIR=data/session
BOT_HTTP_PORT=21268
BOT_MAX_RETRIES=3
BOT_POLL_MS=2000
BOT_SESSION_KEEPALIVE_MS=5400000
BOT_SESSION_KEEPALIVE_RETRY_MS=600000
BOT_KEEPALIVE_CHECK_MS=60000

BOT_CATALOG_PUSH_ENABLED=false

# Scan au démarrage + tous les jours 17h (Europe/Paris)
# Relance mail J, contentieux mois suivant, résil 24h après (mois en cours)
ECHEANCIER_DRY_RUN=0
ECHEANCIER_CRON_HOUR=17
ECHEANCIER_CRON_TZ=Europe/Paris
ECHEANCIER_CRON_MS=0
ECHEANCIER_STARTUP_SCAN=1
ECHEANCIER_CONTENTIEUX_HOURS=24
ECHEANCIER_LIMIT=30

BOXPLUS_HOSTED=1
PLAYWRIGHT_BROWSERS_PATH=data/ms-playwright
TMPDIR=data/tmp

SYNC_SECRET=
BOXPLUS_STORE_URL=https://box-plus.vercel.app
STORE_URL=https://box-plus.vercel.app

ALERT_WEBHOOK_URL=
ALERT_EMAIL=
