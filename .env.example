# Deciplus
DECIPLUS_URL=https://boxingcenter.deciplus.pro/
DECIPLUS_USER=
DECIPLUS_PASSWORD=
DECIPLUS_HEADLESS=true
DECIPLUS_SLOW_MO=50
DECIPLUS_DEFAULT_SITE=Minimes
# Accélère vérif / résiliation / changement (délais Playwright ×0.3)
DECIPLUS_FAST=1

# Bot
BOT_DATA_DIR=data
BOT_SESSION_DIR=data/session
BOT_HTTP_PORT=3050
BOT_MAX_RETRIES=3
BOT_POLL_MS=5000
BOT_CATALOG_PUSH_ENABLED=true
BOT_CATALOG_PUSH_MS=21600000
# Keepalive session Deciplus (token ~4h) — ping toutes les 2h30
BOT_SESSION_KEEPALIVE_MS=9000000
BOT_SESSION_KEEPALIVE_RETRY_MS=900000
BOT_KEEPALIVE_CHECK_MS=60000
# Cooldown après échec MFA (évite rafale d'emails code Deciplus)
BOT_AUTH_COOLDOWN_MS=600000

# Nettoyage ventes test — scan IDs Deciplus (optionnel)
CLEANUP_SCAN_ID_RANGE=20899-20950

# Badge — prélèvement IBAN différé (~72h = 3 jours calendaires)
BADGE_PRELEVEMENT_DELAY_DAYS=3
BADGE_PRELEVEMENT_DELAY_MIN=3
BADGE_PRELEVEMENT_DELAY_MAX=3

# Push catalogue → boutique (Vercel)
STORE_INGEST_URL=https://box-plus.vercel.app/api/admin/ingest-catalog
BOXPLUS_STORE_URL=https://box-plus.vercel.app
STORE_URL=https://box-plus.vercel.app
# Code email Deciplus — lecture auto via IMAP (mot de passe d'APPLICATION)
DECIPLUS_IMAP_USER=konizakonza3@gmail.com
DECIPLUS_IMAP_PASS=
DECIPLUS_IMAP_HOST=imap.gmail.com
DECIPLUS_IMAP_PORT=993

SYNC_SECRET=change-me-in-production

# Alertes email nouveau membre (Brevo direct depuis le bot — emails @boxplus-test.local ignorés)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=suzinabot@gmail.com
BREVO_SENDER_NAME=Boxing Center
ADMIN_EMAIL=
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
